{
  "name": "quiz-control",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "test": "node --test test/*.test.js",
    "build:video": "node build-video-processor.mjs",
    "prepare:deploy": "npm run build:video && node prepare-deploy.mjs",
    "deploy": "npm run prepare:deploy && set -a; source .env.local; set +a; wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "mediabunny": "1.45.1"
  },
  "devDependencies": {
    "wrangler": "^4.121.0"
  }
}
