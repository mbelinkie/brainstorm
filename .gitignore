.env.local
.env.*.local
# wrangler's local-secret mechanism for `wrangler dev` (SUPABASE_SERVICE_ROLE_KEY
# et al.) -- same sensitivity as .env.local above, must never be committed.
.dev.vars
.dev.vars.*
# Leftover from a Finder save attempt that couldn't use a leading dot -- same
# sensitivity as .dev.vars above. Delete the file itself once confirmed unused.
dev.vars.txt
.DS_Store

# Dependencies and generated deploy/runtime files
node_modules/
.deploy-assets/
video-processor.worker.bundle.js
.codex-tmp/
.wrangler/
.next/
dist/

# Raw source media stays on the authoring machine (published, optimized media
# is stored in Supabase and referenced by the committed quiz definitions).
music quiz originals/

# Local reference material: promo art, vendor API notes, scratch documents.
# Not shipped, not deployed, not part of the product.
local-reference/

# Agent worktrees and local session state.
.claude/
