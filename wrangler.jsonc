{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wild-haze-73b3",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": ".deploy-assets",
    "binding": "ASSETS",
    "run_worker_first": ["/media/*", "/author-media/*", "/media-assistant/*", "/media-health"]
  }
}
