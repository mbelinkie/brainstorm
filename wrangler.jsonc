{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wild-haze-73b3",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-08-11",
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "assets": {
    "directory": ".deploy-assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/__version",
      "/media/*",
      "/author-media/*",
      "/media-health"
    ]
  },
  // Workers AI: zero-credential image generation for Prompt Battle's
  // workers_ai adapter (image-engine.js). No secret, no key, no account ID
  // -- the binding is the credential. See
  // docs/superpowers/specs/2026-08-24-prompt-battle-free-engine-addendum.md
  // section 7.
  "ai": {
    "binding": "AI"
  }
}