{
  "_comment": "Delegation harness settings (docs/delegation/HARNESS_SPEC.md). No secrets here: the DeepSeek key is read from a private file outside the repository.",
  "repository": { "owner": "mbelinkie", "name": "brainstorm", "integrationBranch": "main", "remote": "origin" },
  "branchPrefix": "codex/delegate-",
  "worktreeParent": "..",
  "worktreePrefix": "quiz-delegate-",
  "testGlob": "test/*.test.js",
  "testFileGlobs": ["test/**"],
  "acceptanceDir": "test",
  "evidenceDir": "docs/delegation/evidence",
  "fitGate": { "flagLabels": ["type:design", "type:research", "design", "research"] },
  "protectedPaths": [
    "supabase/migrations/**",
    "scripts/roadmap/**",
    "scripts/guard/**",
    "tools/delegate/**",
    "tools/codex-batch.mjs",
    "tools/batch-core.mjs",
    ".claude/**",
    ".github/**",
    ".env*",
    ".dev.vars",
    "wrangler.jsonc",
    "prepare-deploy.mjs"
  ],
  "configPaths": ["package.json", "package-lock.json", ".github/**", "wrangler.jsonc", ".nvmrc", ".node-version", ".claude/**"],
  "dependencyFiles": ["package.json", "package-lock.json"],
  "contextExcludes": [".env*", "**/.env*", ".dev.vars", "node_modules/**", "**/*.pem", "**/*.key", "*.docx", "*.zip", "*.png", "*.jpg", "assets/**", "docs/CLAUDE_WORKLOG.md", "CHANGELOG.md"],
  "lanes": {
    "express": { "maxFiles": 3, "maxLines": 60 },
    "standard": { "maxFiles": 12, "maxLines": 400 },
    "protected": { "maxFiles": 20, "maxLines": 800 }
  },
  "ladder": [
    { "model": "deepseek-flash", "effort": "high", "fresh": true },
    { "model": "deepseek-flash", "effort": "high", "fresh": false },
    { "model": "deepseek-v4-pro", "effort": "high", "fresh": true },
    { "model": "deepseek-v4-pro", "effort": "max", "fresh": true }
  ],
  "repairStartRung": 2,
  "deepseek": {
    "baseUrl": "https://api.deepseek.com",
    "keyFileEnv": "DEEPSEEK_KEY_FILE",
    "defaultKeyFile": "deepseek.key",
    "jsonMode": false,
    "maxTokens": 65536,
    "lengthRetryMaxTokens": 131072,
    "usdPerBatch": 10,
    "timeoutMs": 600000,
    "scout": { "model": "deepseek-flash", "effort": "low" },
    "testAuthor": { "model": "deepseek-v4-pro", "effort": "high" },
    "contextTokenCap": 200000
  },
  "codex": {
    "command": "codex",
    "sandbox": "workspace-write",
    "extraConfig": ["sandbox_workspace_write.network_access=true"],
    "roles": {
      "controller": { "model": "gpt-6-luna", "effort": "high", "card": "docs/delegation/cards/controller.md" },
      "triage": { "model": "gpt-6-luna", "effort": "medium", "card": "docs/delegation/cards/controller.md" },
      "verifier": { "model": "gpt-6-luna", "effort": "medium", "card": "docs/delegation/cards/verifier.md" },
      "sol": { "model": "gpt-6.1-sol", "effort": "high", "card": "docs/delegation/cards/sol.md" }
    },
    "timeoutMs": 1800000
  },
  "budgets": {
    "controller": { "input": 300000, "output": 20000 },
    "triage": { "input": 300000, "output": 20000 },
    "verifier": { "input": 150000, "output": 8000 },
    "sol": { "input": 1500000, "output": 40000 },
    "sessionsPerTicket": { "express": 2, "standard": 4, "protected": 6 }
  },
  "plan": { "headroomPercent": 80, "creditCap": 0, "requireUsageReading": true },
  "batch": { "deadlineHours": 8, "triageBatchSize": 10 }
}
